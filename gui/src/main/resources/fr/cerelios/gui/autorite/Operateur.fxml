<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.cerelios.gui.autorite.Operateur" spacing="16">

    <VBox styleClass="carte" spacing="10">
        <Label text="Accès" styleClass="titre-carte"/>
        <GridPane hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Serveur de credentials" styleClass="libelle"/>
            <TextField fx:id="serveur" text="localhost:5001" GridPane.columnIndex="1"/>
            <Label text="Référendum" styleClass="libelle" GridPane.rowIndex="1"/>
            <TextField fx:id="referendum" promptText="Numéro du référendum"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Graine" styleClass="libelle" GridPane.rowIndex="2"/>
            <PasswordField fx:id="graine" promptText="Graine reçue par e-mail"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
        <Label styleClass="aide" wrapText="true"
               text="Sans la graine, le serveur ne peut plus relire les credentials qu'il garde chiffrés : elle n'existe que dans votre e-mail."/>
    </VBox>

    <VBox styleClass="carte" spacing="10">
        <Label text="Certificat" styleClass="titre-carte"/>
        <Label styleClass="aide" wrapText="true"
               text="Vérifie que le certificat publié par l'urne est signé avec les clés de votre graine et porte sur les credentials publiés."/>
        <Button text="Vérifier le certificat" styleClass="principal" onAction="#verifier"/>
    </VBox>

    <VBox styleClass="carte" spacing="10">
        <Label text="Renvoyer des credentials" styleClass="titre-carte"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Crédits restants :"/>
            <Label fx:id="credits" text="—" styleClass="etape"/>
            <Button text="Actualiser" onAction="#credits"/>
        </HBox>
        <HBox spacing="8">
            <TextField fx:id="destinataires" promptText="identifiants séparés par des virgules"
                       HBox.hgrow="ALWAYS"/>
            <Button text="Renvoyer à ces électeurs" onAction="#renvoyerA"/>
        </HBox>
        <FlowPane hgap="8" vgap="8">
            <Button text="Renvoyer à ceux qui n'ont pas voté" onAction="#renvoyerSansBulletin"/>
            <Button text="Renvoyer à tous" onAction="#renvoyerATous"/>
        </FlowPane>
        <Label styleClass="aide" text="Chaque e-mail envoyé coûte un crédit."/>
    </VBox>
</VBox>
