<?xml version="1.0" encoding="UTF-8"?>

<?import fr.cerelios.gui.ChampCopiable?>
<?import fr.cerelios.gui.ChampFichier?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.cerelios.gui.autorite.Autorite" spacing="16">

    <VBox styleClass="carte" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Référendum" styleClass="titre-carte"/>
        <GridPane hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Référendum" styleClass="libelle"/>
            <TextField fx:id="referendum" promptText="Numéro du référendum" GridPane.columnIndex="1"/>
            <Label text="Jeton" styleClass="libelle" GridPane.rowIndex="1"/>
            <TextField fx:id="jeton" promptText="Jeton remis par l'administrateur"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <Button text="Charger la liste des électeurs" onAction="#charger"/>
        <ListView fx:id="electeurs" VBox.vgrow="ALWAYS" minHeight="120">
            <placeholder><Label text="Chargez la liste pour la relire avant de générer."/></placeholder>
        </ListView>
    </VBox>

    <VBox styleClass="carte" spacing="10">
        <Label text="Credentials" styleClass="titre-carte"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Fichier" styleClass="libelle"/>
            <ChampFichier fx:id="fichier" invite="Fichier des credentials secrets"
                          libelleGenerer="Générer un fichier…" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Label styleClass="aide" wrapText="true"
               text="Choisissez votre fichier de credentials, ou générez-en un : une ligne « électeur:secret » par électeur de la liste, enregistrée où vous voulez et modifiable avant publication. Seule la partie publique de chaque credential part à l'urne ; remettez les secrets aux électeurs par vos propres moyens."/>
        <HBox spacing="8">
            <Button text="Publier les credentials" styleClass="principal" onAction="#publier"/>
            <Button text="Vérifier la publication" onAction="#verifier"/>
        </HBox>
    </VBox>

    <VBox styleClass="carte" spacing="10">
        <Label text="Credential perdu" styleClass="titre-carte"/>
        <Label styleClass="aide" text="Retrouve le credential d'un électeur dans le fichier."/>
        <HBox spacing="8">
            <TextField fx:id="recherche" promptText="Identifiant de l'électeur" HBox.hgrow="ALWAYS"/>
            <Button text="Retrouver" onAction="#retrouver"/>
        </HBox>
        <ChampCopiable fx:id="credential" invite="Credential retrouvé"/>
    </VBox>
</VBox>
