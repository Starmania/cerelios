<?xml version="1.0" encoding="UTF-8"?>

<?import fr.cerelios.gui.FicheReferendum?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.cerelios.gui.auditeur.Audit" spacing="16">

    <VBox styleClass="carte" spacing="10">
        <Label text="Référendum" styleClass="titre-carte"/>
        <HBox spacing="8">
            <TextField fx:id="referendum" promptText="Numéro du référendum" HBox.hgrow="ALWAYS"/>
            <Button text="Vérifier" styleClass="principal" defaultButton="true" onAction="#verifier"/>
        </HBox>
        <Label styleClass="aide" wrapText="true"
               text="Télécharge les données publiques et vérifie : preuves des clés, certificat, chaque bulletin et sa signature, le total chiffré, les déchiffrements partiels et le résultat."/>
    </VBox>

    <VBox styleClass="carte" spacing="10">
        <Label text="Rechercher un traceur" styleClass="titre-carte"/>
        <HBox spacing="8">
            <TextField fx:id="traceur" HBox.hgrow="ALWAYS"
                       promptText="Traceur du récépissé de l'électeur (64 caractères)"/>
            <Button fx:id="rechercher" text="Rechercher" onAction="#rechercher"/>
        </HBox>
        <Label styleClass="aide" wrapText="true"
               text="Le traceur est l'empreinte du bulletin chiffré : il prouve qu'un bulletin est dans l'urne publiée, donc compté, sans révéler ni le vote ni l'électeur."/>
    </VBox>

    <FicheReferendum fx:id="fiche" visible="false" managed="false"/>

    <VBox fx:id="carteResultat" styleClass="carte" spacing="10" VBox.vgrow="ALWAYS"
          visible="false" managed="false">
        <Label text="Contrôles" styleClass="titre-carte"/>
        <VBox fx:id="resume" spacing="6"/>
        <ListView fx:id="anomalies" VBox.vgrow="ALWAYS" minHeight="120">
            <placeholder><Label text="Aucune anomalie."/></placeholder>
        </ListView>
    </VBox>
</VBox>
