<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.cerelios.gui.Connexion" alignment="TOP_CENTER">
    <padding><Insets top="40" right="20" bottom="20" left="20"/></padding>

    <VBox styleClass="carte" spacing="10" maxWidth="460">
        <Label text="Connexion" styleClass="titre-carte"/>
        <Label fx:id="aide" styleClass="aide" wrapText="true"/>
        <GridPane hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Identifiant" styleClass="libelle"/>
            <TextField fx:id="identifiant" promptText="Identifiant" GridPane.columnIndex="1"/>
            <Label text="Mot de passe" styleClass="libelle" GridPane.rowIndex="1"/>
            <PasswordField fx:id="secret" promptText="Mot de passe"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <Button text="Se connecter" styleClass="principal" defaultButton="true"
                onAction="#connecter"/>
    </VBox>
</VBox>
