<?xml version="1.0" encoding="UTF-8"?>

<?import fr.cerelios.gui.ChampCopiable?>
<?import fr.cerelios.gui.ChampDate?>
<?import fr.cerelios.gui.FicheReferendum?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.cerelios.gui.administrateur.EditionReferendum" spacing="16">

    <HBox spacing="8">
        <Button text="← Mes référendums" styleClass="lien" onAction="#retour"/>
        <Button text="Actualiser" onAction="#recharger"/>
    </HBox>

    <FicheReferendum fx:id="fiche"/>

    <TabPane fx:id="onglets" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" minHeight="420">

        <!-- Question et calendrier -->
        <Tab text="Question et calendrier">
            <VBox styleClass="onglet" spacing="12">
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Question" styleClass="libelle"/>
                    <TextField fx:id="question" GridPane.columnIndex="1"/>
                </GridPane>
                <Button fx:id="enregistrerQuestion" text="Enregistrer la question"
                        onAction="#enregistrerQuestion"/>
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Ouverture" styleClass="libelle"/>
                    <ChampDate fx:id="ouverture" GridPane.columnIndex="1"/>
                    <Label text="Clôture" styleClass="libelle" GridPane.rowIndex="1"/>
                    <ChampDate fx:id="cloture" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Publication" styleClass="libelle" GridPane.rowIndex="2"/>
                    <ChampDate fx:id="publication" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Délai de grâce (min)" styleClass="libelle" GridPane.rowIndex="3"/>
                    <Spinner fx:id="grace" min="0" max="1440" initialValue="0" amountToStepBy="5"
                             editable="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
                <Label styleClass="aide" wrapText="true"
                       text="Rien n'est manuel : le vote s'ouvre et se clôt à ces dates, et le résultat paraît dès la publication passée et les déchiffrements reçus. Le délai de grâce laisse finir les électeurs connectés avant la clôture."/>
                <Button text="Enregistrer le calendrier" styleClass="principal"
                        onAction="#enregistrerDates"/>
            </VBox>
        </Tab>

        <!-- Électeurs -->
        <Tab text="Électeurs">
            <VBox styleClass="onglet" spacing="12">
                <Label styleClass="aide" wrapText="true"
                       text="Un électeur par ligne : son identifiant auprès du fournisseur d'identité, puis, séparée par une espace, son adresse e-mail. L'adresse est obligatoire avec un serveur de credentials, qui écrit lui-même aux électeurs. Les adresses ne sont pas relues : ressaisissez-les si vous modifiez la liste."/>
                <Label styleClass="exemple" text="bob bob@exemple.fr&#10;carol carol@exemple.fr&#10;dave"/>
                <TextArea fx:id="electeurs" VBox.vgrow="ALWAYS" prefRowCount="10"
                          promptText="identifiant adresse-e-mail, un électeur par ligne"/>
                <Button fx:id="enregistrerElecteurs" text="Enregistrer la liste" styleClass="principal"
                        onAction="#enregistrerElecteurs"/>
            </VBox>
        </Tab>

        <!-- Scrutateurs -->
        <Tab text="Scrutateurs">
            <VBox styleClass="onglet" spacing="12">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Seuil"/>
                    <Spinner fx:id="seuil" min="0" max="50" initialValue="0" amountToStepBy="1"
                             editable="true"/>
                    <Button fx:id="enregistrerSeuil" text="Enregistrer le seuil"
                            onAction="#enregistrerSeuil"/>
                </HBox>
                <Label styleClass="aide" wrapText="true"
                       text="0 : chaque scrutateur a sa propre clé et tous devront déchiffrer. k &gt; 0 : les scrutateurs génèrent la clé ensemble et k d'entre eux suffiront. Le seuil se fixe avant que les scrutateurs commencent."/>
                <TableView fx:id="scrutateurs" VBox.vgrow="ALWAYS" minHeight="140">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label text="Aucun scrutateur"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colIndice" text="N°" prefWidth="50"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
                        <TableColumn fx:id="colCle" text="Clé" prefWidth="220"/>
                        <TableColumn fx:id="colDechiffrement" text="Déchiffrement" prefWidth="140"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <TextField fx:id="nomScrutateur" promptText="Nom" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="emailScrutateur" promptText="adresse e-mail" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="inviter" text="Inviter" styleClass="principal" onAction="#inviter"/>
                </HBox>
                <Label styleClass="aide" wrapText="true"
                       text="Chaque scrutateur reçoit par e-mail le numéro du référendum, son nom et son jeton."/>
            </VBox>
        </Tab>

        <!-- Credentials -->
        <Tab text="Credentials">
            <VBox styleClass="onglet" spacing="12">
                <fx:define>
                    <ToggleGroup fx:id="mode"/>
                </fx:define>
                <HBox spacing="16">
                    <RadioButton fx:id="manuelle" text="Autorité de certification manuelle"
                                 toggleGroup="$mode" selected="true"/>
                    <RadioButton fx:id="serveur" text="Serveur de credentials" toggleGroup="$mode"/>
                </HBox>
                <VBox fx:id="blocManuel" spacing="8">
                    <Label styleClass="aide" wrapText="true"
                           text="Transmettez ce jeton et le numéro du référendum à l'autorité de certification. Elle génère les credentials et les remet elle-même aux électeurs."/>
                    <ChampCopiable fx:id="jetonAutorite" invite="Cliquez sur « Afficher le jeton »"/>
                    <Button text="Afficher le jeton" onAction="#afficherJeton"/>
                </VBox>
                <VBox fx:id="blocServeur" spacing="8">
                    <GridPane hgap="12" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Serveur" styleClass="libelle"/>
                        <TextField fx:id="adresseServeur" promptText="hôte:port, par exemple localhost:5001"
                                   GridPane.columnIndex="1"/>
                        <Label text="Opérateur" styleClass="libelle" GridPane.rowIndex="1"/>
                        <TextField fx:id="emailOperateur"
                                   promptText="adresse de l'opérateur, qui recevra la graine"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </GridPane>
                    <HBox spacing="8">
                        <Button text="Enregistrer le serveur" onAction="#enregistrerServeur"/>
                        <Button text="Demander les credentials" styleClass="principal"
                                onAction="#demanderCredentials"/>
                    </HBox>
                    <Label styleClass="aide" wrapText="true"
                           text="Le serveur génère les credentials, envoie la graine à l'opérateur, puis écrit à chaque électeur quand vous validez. Il faut une adresse e-mail par électeur."/>
                </VBox>
            </VBox>
        </Tab>

        <!-- Validation -->
        <Tab text="Validation">
            <VBox styleClass="onglet" spacing="12">
                <Label text="Ce qui manque avant de valider"/>
                <ListView fx:id="manques" VBox.vgrow="ALWAYS" minHeight="120">
                    <placeholder><Label text="Rien ne manque : le référendum peut être validé."/></placeholder>
                </ListView>
                <HBox spacing="8">
                    <Button fx:id="valider" text="Valider" styleClass="principal" onAction="#valider"/>
                    <Button text="Actualiser" onAction="#chargerManques"/>
                </HBox>
                <Label styleClass="aide" wrapText="true"
                       text="Sceller inscrit les dates au journal public et les fige : personne, pas même vous, ne pourra avancer ou repousser le vote."/>
                <Button fx:id="sceller" text="Sceller le calendrier" onAction="#sceller"/>
            </VBox>
        </Tab>

        <!-- Suivi -->
        <Tab text="Suivi">
            <VBox styleClass="onglet" spacing="12">
                <Label styleClass="aide" text="Qui a voté et quand ; jamais pour quoi."/>
                <TableView fx:id="emargement" VBox.vgrow="ALWAYS" minHeight="140">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label text="Personne n'a encore voté."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colElecteur" text="Électeur" prefWidth="260"/>
                        <TableColumn fx:id="colDate" text="Dernier vote" prefWidth="200"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <Button text="Actualiser" onAction="#chargerEmargement"/>
                    <Button text="Archiver" onAction="#archiver"/>
                    <Button text="Supprimer" styleClass="danger" onAction="#supprimer"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
