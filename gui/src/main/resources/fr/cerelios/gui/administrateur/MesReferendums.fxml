<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.cerelios.gui.administrateur.MesReferendums" spacing="16">

    <VBox styleClass="carte" spacing="10">
        <Label text="Nouveau référendum" styleClass="titre-carte"/>
        <HBox spacing="8">
            <TextField fx:id="question" HBox.hgrow="ALWAYS"
                       promptText="Question posée, par exemple « Approuvez-vous le budget 2027 ? »"/>
            <Button fx:id="creer" text="Créer" styleClass="principal" onAction="#creer"/>
        </HBox>
    </VBox>

    <VBox styleClass="carte" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Mes référendums" styleClass="titre-carte"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" minHeight="160">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <placeholder><Label text="Aucun référendum : créez-en un ci-dessus."/></placeholder>
            <columns>
                <TableColumn fx:id="colQuestion" text="Question" prefWidth="380"/>
                <TableColumn fx:id="colEtat" text="État" prefWidth="190"/>
                <TableColumn fx:id="colBulletins" text="Bulletins" prefWidth="90"/>
                <TableColumn fx:id="colNumero" text="Numéro" prefWidth="200"/>
            </columns>
        </TableView>
        <HBox spacing="8">
            <Button fx:id="ouvrir" text="Ouvrir" onAction="#ouvrirSelection"/>
            <Button text="Actualiser" onAction="#charger"/>
        </HBox>
    </VBox>
</VBox>
