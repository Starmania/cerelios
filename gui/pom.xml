<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.cerelios</groupId>
        <artifactId>cerelios</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>gui</artifactId>
    <description>Interface JavaFX de tous les rôles : électeur, administrateur, scrutateur, autorité, opérateur, auditeur</description>

    <properties>
        <cerelios.main>fr.cerelios.gui.MainApp</cerelios.main>
    </properties>

    <dependencies>
        <!-- Programmes clients de chaque rôle -->
        <dependency>
            <groupId>fr.cerelios</groupId>
            <artifactId>electeur</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cerelios</groupId>
            <artifactId>scrutateur</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cerelios</groupId>
            <artifactId>autorite</artifactId>
        </dependency>
        <!-- Pour Demo seulement : urne et serveur de credentials lancés sur ce poste -->
        <dependency>
            <groupId>fr.cerelios</groupId>
            <artifactId>urne</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.cerelios</groupId>
            <artifactId>certification</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- -Dcerelios.main=fr.cerelios.gui.Demo lance l'urne et le serveur de démonstration -->
                    <mainClass>${cerelios.main}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
