# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

[*.xml]
indent_style = space
indent_size = 4

[*.{yml,yaml,proto,json}]
indent_style = space
indent_size = 2

# Deux espaces en fin de ligne = saut de ligne en Markdown
[*.md]
trim_trailing_whitespace = false

# Fichiers générés par le Maven Wrapper : on n'y touche pas
[{mvnw,.mvn/**}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset

[*.{cmd,bat}]
end_of_line = crlf
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
